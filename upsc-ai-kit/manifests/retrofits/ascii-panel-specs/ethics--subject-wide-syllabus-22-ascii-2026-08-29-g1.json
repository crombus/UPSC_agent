            "        v",
            "  [4] Add uncertainty exposure",
            "        |",
            "        v",
            "  [5] State surviving risk",
            "        |",
            "        v",
            "  [6] Choose monitoring indicator",
            "        |",
            "        v",
            "  [7] Name accountable authority",
            "        |",
            "        v",
            "  [8] Set review or trigger date",
            "        |",
            "        v",
