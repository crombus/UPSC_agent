{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.upsc-agent/schemas/learner-v2-section-manifest.json",
  "title": "Learner-v2 section manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "variant",
    "subject",
    "section",
    "topics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "variant": {
      "const": "learner-v2"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "display_name"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "scope",
        "complete_syllabus_section",
        "syllabus_sources"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "official-section",
            "pilot"
          ]
        },
        "complete_syllabus_section": {
          "type": "boolean"
        },
        "syllabus_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topic"
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^[A-Za-z]:"
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_key",
        "display_title",
        "syllabus_mapping",
        "cross_topic_sources",
        "verified_pyq_sources"
      ],
      "anyOf": [
        {
          "required": [
            "source_basic"
          ]
        },
        {
          "required": [
            "source_canonical"
          ]
        }
      ],
      "properties": {
        "topic_key": {
          "type": "string",
          "minLength": 1
        },
        "display_title": {
          "type": "string",
          "minLength": 1
        },
        "syllabus_mapping": {
          "type": "string",
          "minLength": 1
        },
        "source_basic": {
          "$ref": "#/$defs/repositoryPath"
        },
        "source_canonical": {
          "$ref": "#/$defs/repositoryPath"
        },
        "source_advanced": {
          "oneOf": [
            {
              "$ref": "#/$defs/repositoryPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "cross_topic_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "verified_pyq_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "assembled_markdown": {
          "$ref": "#/$defs/repositoryPath"
        },
        "notes_pdf": {
          "$ref": "#/$defs/repositoryPath"
        },
        "workbook_pdf": {
          "$ref": "#/$defs/repositoryPath"
        },
        "superseded_v1": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracker_topic_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
