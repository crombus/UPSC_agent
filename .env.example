# ─────────────────────────────────────────────
#  UPSC Agent — Environment Variables
#  Copy this to .env and fill in your keys.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── LLM Provider (pick one) ──────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# ── Azure AI Foundry (if using Foundry) ──────
AZURE_FOUNDRY_ENDPOINT=https://<your-project>.openai.azure.com/
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_FOUNDRY_CHAT_DEPLOYMENT=gpt-4.1

# ── Azure OpenAI (if using Azure directly) ───
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-02-01

# ── Azure GPT Image (PDF illustrations) ───────
# Full deployment URL ending in /images/generations. The client replaces any
# api-version query value with AZURE_IMAGE_API_VERSION.
AZURE_IMAGE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/openai/deployments/<deployment>/images/generations
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_API_VERSION=2025-04-01-preview
AZURE_IMAGE_SIZE=1536x1024
AZURE_IMAGE_QUALITY=medium

# ── Web Search ───────────────────────────────
# Tavily: AI-powered search with citations (recommended)
# Get free key at https://tavily.com
TAVILY_API_KEY=
# If not set, DuckDuckGo is used automatically (no key needed)

# ── Vector DB ────────────────────────────────
CHROMA_PERSIST_DIR=./vectordb/static
CHROMA_DYNAMIC_DIR=./vectordb/dynamic
